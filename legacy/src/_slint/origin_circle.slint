export component OriginCircle inherits Rectangle {
    // Mirrors Taskbar API so it uses same MainWindow variables:
    // active <=> dock-active, pill-active <=> taskbar-active, selection <=> dock-selection
    in property <bool> active: false;
    in property <bool> pill-active: false;
    in property <int> selection: 0;
    in property <bool> origin_screen_toggle:false;

    // Keep label separate from Taskbar so both are readable when dock is active.
    // Taskbar label is centered; Origin is offset left so they don't overlap.
    label := Text {
        x: (parent.width - 100px) / 2 - 120px;
        y: parent.height - 62px;
        width: 100px;

        text: "ORIGIN";
        color: #00b3b3;
        font-size: 11px;
        horizontal-alignment: center;
        visible: root.active;
    }

    // The actual circle — 36x36, sits 8px left of the taskbar pill.
    // Taskbar pill is 190px wide centered: x = (W-190)/2.
    // Circle x = pill_x - 36 - 8 = (W-190)/2 - 44.
    circle := Rectangle {
        x: (parent.width - 190px) / 2 - 44px;
        y: parent.height - 45px;

        width: 36px;
        height: 36px;
        border-radius: 18px;
        border-width: root.active ? 2px : 0px;
        border-color: #00b3b3;

        // Highlights when selection == 0 (the "origin" slot in taskbar.rs).
        // Otherwise shows idle. Mirrors TaskbarIcon selected ? #00b3b3 : #454444.
        background: root.selection == 0 ? #00b3b3 : #1a1a1a;
        visible: root.pill-active;

        // inner icon — smaller dot to show selected state clearly
        inner := Rectangle {
            x: (parent.width - 33px) / 2;
            y: (parent.height - 33px) / 2;
            width: 33px;
            height: 33px;
            border-radius: 33px;
            background: root.selection == 0 ? #1a1a1a : #454444;   
        }
    }

    // Peeking state — same y as Taskbar hidden_pill (-10px) so both peek
    // together when dock is hidden. Still 36x36 circle, not a pill.
    hidden_circle := Rectangle {
        x: ((parent.width) / 2) - 20px;
        y: parent.height - 50px;

        width: 36px;
        height: 36px;
        border-radius: 18px;
        border-width: 2px;
        border-color: #00b3b3;

        background: #1a1a1a;
        visible: !root.pill-active;
    }

    origin_screen := Rectangle {
        x: (parent.width - 340px) / 2;
        y: parent.height - 410px;

        width: 340px;
        height: 360px;
        border-radius: 12px;
        border-width: 1px;
        border-color: #008080;

        background: #1a1a1a;
        visible: root.origin_screen_toggle;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            // Search — single line, no Flickable, cheap like SystemInfo SysPanel
            Rectangle {
                height: 32px;
                background: #0a0a0a;
                border-width: 1px;
                border-color: #00808033;
                border-radius: 16px;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "⌕";
                        color: #5a5a5a;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Type here to search";
                        color: #5a5a5a;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
            }

            // Pinned header
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                Rectangle {
                    width: 64px;
                    height: 20px;
                    background: #0a0a0a;
                    border-width: 1px;
                    border-color: #00808022;
                    border-radius: 4px;

                    Text {
                        text: "All apps >";
                        color: #8a8a8a;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // placeholders - was 6-app grid, now plain rectangles as requested
            GridLayout {
                spacing: 8px;

                Rectangle { row: 0; col: 0; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 0; col: 1; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 0; col: 2; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 1; col: 0; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 1; col: 1; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 1; col: 2; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 2; col: 0; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 2; col: 1; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
                Rectangle { row: 2; col: 2; height: 64px; background: #0a0a0a; border-width: 1px; border-color: #00808022; border-radius: 8px; }
            }

            // Spacer
            Rectangle { vertical-stretch: 1; background: #00000000; }

            // Bottom bar — user + power, like Windows
            Rectangle {
                height: 40px;
                background: #0a0a0a;
                border-width: 1px;
                border-color: #00808022;
                border-radius: 8px;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: #00b3b3;
                            Text { text: "O"; color: #0a0a0a; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text {
                            text: "origin-dev";
                            color: #d4d4d4;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: #1a1a1a;
                        border-width: 1px;
                        border-color: #00808033;

                        Text { text: "⏻"; color: #d4d4d4; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
