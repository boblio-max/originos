import { CommandBubble } from "command_bubble.slint";
import { QuickSettings } from "quick_settings.slint";
import { Taskbar } from "taskbar.slint";
import { OriginCircle } from "origin_circle.slint";
import { SettingWindow } from "settingswindow.slint";
import { SystemInfo } from "systeminfo.slint";
import { Window2 } from "window2.slint";
import { Window3 } from "window3.slint";
import { Window4 } from "window4.slint";
import { Window5 } from "window5.slint";

export component MainWindow inherits Window {
title: "Origin OS";
width: 1100px;
height: 650px;
background: #0c0c0c;

    default-font-family: "monospace";
    default-font-size: 15px;

    in property <string> terminal-text: "";
    in property <string> bubble-text: "origin-dev@OrOS-DEV:~$";
    in property <string> bubble-gen-text: "";
    in-out property <bool> shortcut_pressed: false;
    in-out property <bool> output_generated: false;
    // Rust receives every keyboard event directly.
    callback key-input(string, bool);

    // The dock is keyboard-driven: this OS has no mouse.
    in property <bool> dock-active: false;
    in property <bool> taskbar-active: false;
    in property <int> dock-selection: 0;
    in property <bool> qs_active: false;
    in property <bool> qsettings-active: false;
    in property <int> qs-selection: 0;
    in-out property <bool> settings-window-active: false;
    in-out property <int> settings-window-x-translation: 0;
    in-out property <int> settings-window-y-translation: 0;
    in-out property <int> settings-window-x-scale: 0;
    in-out property <int> settings-window-y-scale: 0;
    in-out property <bool> window-1-active: false;
    in-out property <bool> window-1-second-active: false;
    in-out property <int> window-1-x-translation: 0;
    in-out property <int> window-1-y-translation: 0;
    in-out property <int> window-1-x-scale: 0;
    in-out property <int> window-1-y-scale: 0;
    in-out property <bool> window-2-active: false;
    in-out property <int> window-2-x-translation: 0;
    in-out property <int> window-2-y-translation: 0;
    in-out property <int> window-2-x-scale: 0;
    in-out property <int> window-2-y-scale: 0;
    in-out property <bool> window-3-active: false;
    in-out property <int> window-3-x-translation: 0;
    in-out property <int> window-3-y-translation: 0;
    in-out property <int> window-3-x-scale: 0;
    in-out property <int> window-3-y-scale: 0;
    in-out property <bool> window-4-active: false;
    in-out property <int> window-4-x-translation: 0;
    in-out property <int> window-4-y-translation: 0;
    in-out property <int> window-4-x-scale: 0;
    in-out property <int> window-4-y-scale: 0;
    in-out property <bool> window-5-active: false;
    in-out property <int> window-5-x-translation: 0;
    in-out property <int> window-5-y-translation: 0;
    in-out property <int> window-5-x-scale: 0;
    in-out property <int> window-5-y-scale: 0;

    in property <string> thermal_cpu: "CPU : 52.0 C";
    in property <string> thermal_gpu: "GPU : 61.0 C";
    in property <string> thermal_ssd: "SSD : 41.0 C";
    in property <string> thermal_status: "STATUS: NOMINAL";
    in property <string> sys_os: "OS  : OriginOS 1.0.0";
    in property <string> sys_kernel: "KERN: 6.8.0-45-generic";
    in property <string> sys_host: "HOST: OrOS-DEV";
    in property <string> sys_uptime: "UP  : 2d 13h 41m";
    in property <string> proc_header: "PID  PARENT CPU   MEM";
    in property <string> proc_a: "0004 0000   1.2%  34MB";
    in property <string> proc_b: "0567 0004   0.8% 512MB";
    in property <string> proc_c: "0892 0004   4.5% 890MB";
    in property <string> storage_header: "DRV FS   CAP  FREE  TYPE";
    in property <string> storage_a: "C:  NTFS 512G 120G  SSD";
    in property <string> storage_b: "D:  exFAT 1.0T 640G  HDD";
    in property <string> storage_c: "TMP tmpfs 8.0G 3.2G  RAM";
    in property <string> cpu_brand: "CPU : Intel Core i7-13700K";
    in property <string> cpu_cores: "CORE: 16 phys / 24 logical";
    in property <string> cpu_max_freq: "FREQ: 5.30 GHz max";
    in property <string> cpu_cur_freq: "CUR : 3.42 GHz";
    in property <string> mem_total: "TOTAL: 32.0 GB";
    in property <string> mem_avail: "AVAIL: 21.7 GB";
    in property <string> mem_used: "USED : 10.3 GB";
    in property <string> mem_swap: "SWAP : 2.1 / 16.0 GB";

    callback icon-activated(int);

    // ─────────────────────────────────────────────
    // TITLE BAR
    // ─────────────────────────────────────────────

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 28px;

        background: #1a1a1a;

        Text {
            text: "Origin OS";
            color: #d4d4d4;
            font-size: 12px;

            width: parent.width;
            height: parent.height;

            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ─────────────────────────────────────────────
    // ONE TERMINAL
    // ─────────────────────────────────────────────

    terminal := FocusScope {
        x: 0px;
        y: 28px;

        width: parent.width;
        height: parent.height - 28px;

        focus-on-click: true;

        // Grab keyboard focus when the terminal starts.
        init => {
            self.focus();
        }

        key-pressed(event) => {
            root.key-input(
                event.text,
                event.modifiers.control
            );
            accept
        }

        key-released(event) => {
            accept
        }

        // ─────────────────────────────────────────
        // Terminal screen
        // ─────────────────────────────────────────

        Flickable {
            x: 0px;
            y: 0px;

            width: parent.width;
            height: parent.height;

            viewport-width: self.width;
            viewport-height: self.height;

            Text {
                x: 12px;
                y: 12px;

                width: parent.width - 24px;
                height: parent.height - 24px;

                text: root.terminal-text;

                color: #d4d4d4;

                wrap: word-wrap;

                horizontal-alignment: left;
                vertical-alignment: top;
            }
        }
    }

    // ─────────────────────────────────────────────
    // COMMAND BUBBLE — a real secondary shell.
    // ─────────────────────────────────────────────
    // Top-level sibling (not nested inside FocusScope/Flickable)
    // so it's never clipped, and declared last so it always
    // paints on top. Height grows with content instead of being
    // pinned to one line, since it needs room to show output.
    bubble := CommandBubble {
        active: root.shortcut_pressed;
        bubble-text: root.bubble-text;
        bubble-gen-text: root.bubble-gen-text;
        output-generated: root.output_generated;
    }

    taskbar := Taskbar {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        active: root.dock-active;
        pill-active: root.taskbar-active;
        selection: root.dock-selection;
    }

    origin_circle := OriginCircle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        active: root.dock-active;
        pill-active: root.taskbar-active;
        selection: root.dock-selection;
    }

    quick_settings := QuickSettings {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        active: root.qsettings-active;
        pill-active: root.qs_active;
        selection: root.qs-selection;
    }

    setting_window := SettingWindow {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        settings-window-active: root.settings-window-active;
        x_translation: root.settings-window-x-translation;
        y_translation: root.settings-window-y-translation;
        x_scale: root.settings-window-x-scale;
        y_scale: root.settings-window-y-scale;
    }

    window_1 := SystemInfo {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        systeminfo_active: root.window-1-active;
        second_win_active: root.window-1-second-active;
        x_translation: root.window-1-x-translation;
        y_translation: root.window-1-y-translation;
        x_scale: root.window-1-x-scale;
        y_scale: root.window-1-y-scale;
        thermal_cpu <=> root.thermal_cpu;
        thermal_gpu <=> root.thermal_gpu;
        thermal_ssd <=> root.thermal_ssd;
        thermal_status <=> root.thermal_status;
        sys_os <=> root.sys_os;
        sys_kernel <=> root.sys_kernel;
        sys_host <=> root.sys_host;
        sys_uptime <=> root.sys_uptime;
        proc_header <=> root.proc_header;
        proc_a <=> root.proc_a;
        proc_b <=> root.proc_b;
        proc_c <=> root.proc_c;
        storage_header <=> root.storage_header;
        storage_a <=> root.storage_a;
        storage_b <=> root.storage_b;
        storage_c <=> root.storage_c;
        cpu_brand <=> root.cpu_brand;
        cpu_cores <=> root.cpu_cores;
        cpu_max_freq <=> root.cpu_max_freq;
        cpu_cur_freq <=> root.cpu_cur_freq;
        mem_total <=> root.mem_total;
        mem_avail <=> root.mem_avail;
        mem_used <=> root.mem_used;
        mem_swap <=> root.mem_swap;
    }

    window_2 := Window2 {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        window2-active: root.window-2-active;
        x_translation: root.window-2-x-translation;
        y_translation: root.window-2-y-translation;
        x_scale: root.window-2-x-scale;
        y_scale: root.window-2-y-scale;
    }

    window_3 := Window3 {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        window3-active: root.window-3-active;
        x_translation: root.window-3-x-translation;
        y_translation: root.window-3-y-translation;
        x_scale: root.window-3-x-scale;
        y_scale: root.window-3-y-scale;
    }

    window_4 := Window4 {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        window4-active: root.window-4-active;
        x_translation: root.window-4-x-translation;
        y_translation: root.window-4-y-translation;
        x_scale: root.window-4-x-scale;
        y_scale: root.window-4-y-scale;
    }

    window_5 := Window5 {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        window5-active: root.window-5-active;
        x_translation: root.window-5-x-translation;
        y_translation: root.window-5-y-translation;
        x_scale: root.window-5-x-scale;
        y_scale: root.window-5-y-scale;
    }
}
