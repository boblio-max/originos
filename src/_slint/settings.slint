// Settings — OriginOS Settings app
// Matches SystemInfo visual language: #000000dd window, #008080 border, #00b3b3 accent
// User will wire up interactivity later — this is layout + placeholders.

component SidebarItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> selected: false;
    height: 28px;
    border-radius: 2px;
    background: selected ? #00808033 : #00000000;
    border-width: 1px;
    border-color: selected ? #00808066 : #00000000;

    Text {
        x: 8px;
        text: root.label;
        color: selected ? #00b3b3 : #d4d4d4;
        font-size: 11px;
        vertical-alignment: center;
        font-weight: selected ? 700 : 400;
    }
    // selection indicator
    Rectangle {
        x: 0px;
        y: 6px;
        width: 3px;
        height: parent.height - 12px;
        background: #00b3b3;
        border-radius: 1px;
        visible: selected;
    }
}

component Toggle inherits Rectangle {
    in property <bool> checked: false;
    width: 34px;
    height: 18px;
    border-radius: 9px;
    background: checked ? #00b3b3 : #2a2a2a;
    border-width: 1px;
    border-color: checked ? #00b3b3 : #3a3a3a;
    // knob
    Rectangle {
        x: checked ? parent.width - 14px - 2px : 2px;
        y: 2px;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #d4d4d4;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000088;
    }
}

component SliderBar inherits Rectangle {
    in property <float> value: 0.5; // 0..1
    height: 4px;
    background: #1a1a1a;
    border-radius: 2px;
    clip: true;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * value;
        height: parent.height;
        background: #00b3b3;
        border-radius: 2px;
    }
    Rectangle {
        x: parent.width * value - 5px;
        y: -4px;
        width: 10px;
        height: 12px;
        border-radius: 5px;
        background: #d4d4d4;
        border-width: 1px;
        border-color: #00b3b3;
    }
}

component SettingRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    height: 42px;
    background: #0a0a0a;
    border-width: 1px;
    border-color: #00808022;
    border-radius: 3px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: #d4d4d4;
                font-size: 11px;
                vertical-alignment: center;
            }
            Text {
                text: root.subtitle;
                color: #008080;
                font-size: 10px;
                visible: subtitle != "";
            }
        }

        @children
    }
}

export component SettingWindow inherits Rectangle {
    in property <bool> settings_window_active: false;
    in property <int> x_translation: 0;
    in property <int> y_translation: 0;
    in property <int> x_scale: 0;
    in property <int> y_scale: 0;

    // expose for later wiring — user will hook these up
    in property <int> selected-category: 0;
    in property <bool> dark-mode: true;
    in property <bool> animations: true;
    in property <bool> sounds: false;
    in property <float> brightness: 0.75;
    in property <float> volume: 0.6;

    window := Rectangle {
        x: 100px + (x_translation * 1px);
        y: 100px + (y_translation * 1px);
        width: 560px + (x_scale * 1px);
        height: 500px + (y_scale * 1px);
        background: #000000dd;
        border-radius: 6px;
        border-width: 5px;
        border-color: #008080;
        visible: root.settings_window_active;
        clip: true;

        // ── Header ──
        header := Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 28px;
            background: #0a0a0a;
            border-width: 1px;
            border-color: #00808022;

            Text {
                x: 12px;
                y: 0px;
                width: parent.width - 24px;
                height: parent.height;
                text: "SETTINGS";
                color: #00b3b3;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // window chrome dots like other windows
            HorizontalLayout {
                x: parent.width - 42px;
                y: 8px;
                width: 30px;
                height: 12px;
                spacing: 4px;
                Rectangle { width: 8px; height: 8px; background: #00b3b3; border-radius: 4px; }
                Rectangle { width: 8px; height: 8px; background: #454444; border-radius: 4px; }
                Rectangle { width: 8px; height: 8px; background: #454444; border-radius: 4px; }
            }
        }

        // ── Search bar (placeholder) ──
        search := Rectangle {
            x: 12px;
            y: 36px;
            width: parent.width - 24px;
            height: 26px;
            background: #0a0a0a;
            border-width: 1px;
            border-color: #00808033;
            border-radius: 3px;

            Text {
                x: 8px;
                y: 0px;
                width: parent.width - 16px;
                height: parent.height;
                text: "Search settings...";
                color: #5a5a5a;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // ── Main content ──
        content := HorizontalLayout {
            x: 12px;
            y: 70px;
            width: parent.width - 24px;
            height: parent.height - 82px;
            spacing: 8px;

            // Left sidebar
            sidebar := Rectangle {
                width: 132px;
                background: #0a0a0aff;
                border-width: 1px;
                border-color: #00808022;
                border-radius: 3px;

                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;

                    Text {
                        text: "CATEGORIES";
                        color: #008080;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    Rectangle { height: 4px; background: #00000000; }

                    SidebarItem { label: "Appearance"; selected: root.selected-category == 0; }
                    SidebarItem { label: "System";     selected: root.selected-category == 1; }
                    SidebarItem { label: "Display";    selected: root.selected-category == 2; }
                    SidebarItem { label: "Network";    selected: root.selected-category == 3; }
                    SidebarItem { label: "Sound";      selected: root.selected-category == 4; }
                    SidebarItem { label: "About";      selected: root.selected-category == 5; }

                    Rectangle { vertical-stretch: 1; background: #00000000; }

                    // footer hint
                    Text {
                        text: "ARROWS to navigate";
                        color: #3a3a3a;
                        font-size: 9px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Right detail pane
            detail := Rectangle {
                horizontal-stretch: 1;
                background: #0a0a0aff;
                border-width: 1px;
                border-color: #00808022;
                border-radius: 3px;
                clip: true;

                Flickable {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    viewport-width: self.width;
                    viewport-height: layout.preferred-height;

                    layout := VerticalLayout {
                        padding: 8px;
                        spacing: 8px;

                        // ── Appearance section ──
                        Text { text: "APPEARANCE"; color: #00b3b3; font-size: 11px; font-weight: 700; }

                        SettingRow {
                            title: "Dark Mode";
                            subtitle: "Use dark theme across the system";
                            Toggle { checked: root.dark-mode; }
                        }
                        SettingRow {
                            title: "Animations";
                            subtitle: "Enable window transitions";
                            Toggle { checked: root.animations; }
                        }
                        Rectangle {
                            height: 56px;
                            background: #0a0a0a;
                            border-width: 1px;
                            border-color: #00808022;
                            border-radius: 3px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                Text { text: "Brightness"; color: #d4d4d4; font-size: 11px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SliderBar { horizontal-stretch: 1; value: root.brightness; }
                                    Text { text: "75%"; color: #00b3b3; font-size: 10px; width: 32px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #00808022; }

                        // ── System section ──
                        Text { text: "SYSTEM"; color: #00b3b3; font-size: 11px; font-weight: 700; }

                        SettingRow {
                            title: "Notifications";
                            subtitle: "Show system notifications";
                            Toggle { checked: true; }
                        }
                        SettingRow {
                            title: "Auto Updates";
                            subtitle: "Keep OriginOS up to date";
                            Toggle { checked: true; }
                        }
                        SettingRow {
                            title: "Language";
                            subtitle: "English (US)";
                            Text { text: ">"; color: #00b3b3; font-size: 12px; vertical-alignment: center; }
                        }

                        Rectangle { height: 1px; background: #00808022; }

                        // ── Sound section ──
                        Text { text: "SOUND"; color: #00b3b3; font-size: 11px; font-weight: 700; }

                        SettingRow {
                            title: "System Sounds";
                            subtitle: "Play sounds for events";
                            Toggle { checked: root.sounds; }
                        }
                        Rectangle {
                            height: 56px;
                            background: #0a0a0a;
                            border-width: 1px;
                            border-color: #00808022;
                            border-radius: 3px;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                Text { text: "Volume"; color: #d4d4d4; font-size: 11px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    SliderBar { horizontal-stretch: 1; value: root.volume; }
                                    Text { text: "60%"; color: #00b3b3; font-size: 10px; width: 32px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                        }

                        // bottom padding
                        Rectangle { height: 4px; background: #00000000; }
                    }
                }
            }
        }
    }

    label := Text {
        x: 100px + (x_translation * 1px);
        y: 90px + (y_translation * 1px);
        width: 120px;
        text: "Settings";
        color: #00b3b3;
        font-size: 11px + (x_scale * 0.02 * 1px);
        horizontal-alignment: center;
        visible: root.settings_window_active;
    }
}
